  <graph edgedefault="undirected">
    <node id="EVO">
      <data key="d0">EVO</data>
      <data key="d1">Concept</data>
      <data key="d2">EVO is an advanced system for AI agent orchestration that learns and optimizes autonomously using evolutionary algorithms to determine optimal combinations of agents, tools, and workflows for specific tasks.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="Claude Code">
      <data key="d0">Claude Code</data>
      <data key="d1">Method</data>
      <data key="d2">Claude Code serves as the Master Orchestrator in the 3-Layer Agent Architecture, focusing on high-level coordination, context management, and decision-making.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="Subagent Claude">
      <data key="d0">Subagent Claude</data>
      <data key="d1">Method</data>
      <data key="d2">Subagent Claude functions as a domain expert utilizing the Claude API for planning, architecture, and generating responses.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="MCP Server Pydantic">
      <data key="d0">MCP Server Pydantic</data>
      <data key="d1">Method</data>
      <data key="d2">MCP Server Pydantic is a deep specialist that manages domain expertise and code generation in the 3-Layer Agent Architecture.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="OpenEvolve Integration">
      <data key="d0">OpenEvolve Integration</data>
      <data key="d1">Method</data>
      <data key="d2">OpenEvolve Integration is a process that predicts workflows and evaluates them to determine optimal combinations for user requests.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="User Request">
      <data key="d0">User Request</data>
      <data key="d1">Data</data>
      <data key="d2">User Request initiates the workflow routing process in the evolutionary workflow system.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="Workflow Router">
      <data key="d0">Workflow Router</data>
      <data key="d1">Method</data>
      <data key="d2">Workflow Router is responsible for directing user requests to the appropriate workflows based on predictions made by the OpenEvolve Predictor.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="Workflow A">
      <data key="d0">Workflow A</data>
      <data key="d1">Method</data>
      <data key="d2">Workflow A is a quick and efficient process that is executed in parallel within the evolutionary workflow system.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965326</data>
    </node>
    <node id="Workflow B">
      <data key="d0">Workflow B</data>
      <data key="d1">Method</data>
      <data key="d2">Workflow B offers a thorough and validated approach to task execution within the evolutionary workflow system.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965327</data>
    </node>
    <node id="Workflow C">
      <data key="d0">Workflow C</data>
      <data key="d1">Method</data>
      <data key="d2">Workflow C is considered research-heavy and is executed in parallel with other workflows in the system.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965327</data>
    </node>
    <node id="3-Layer Agent Architecture">
      <data key="d0">3-Layer Agent Architecture</data>
      <data key="d1">Concept</data>
      <data key="d2">The 3-Layer Agent Architecture is a framework that organizes the coordination, planning, and execution of tasks using different types of agents in the EVO system.</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965328</data>
    </node>
    <node id="Parallel Execution">
      <data key="d0">Parallel Execution</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d2">Workflow A is executed in parallel for enhanced efficiency.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965328</data>
    </node>
    <node id="OpenEvolve Predictor">
      <data key="d0">OpenEvolve Predictor</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d2">The Workflow Router collaborates with the OpenEvolve Predictor to determine the best workflows for execution.</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757965329</data>
    </node>
    <node id="CLAUDE CODE">
      <data key="d0">CLAUDE CODE</data>
      <data key="d3">chunk-c81c83c832984314cb03a2e4d89ecc5c</data>
      <data key="d2">CLAUDE CODE interacts with MCP Server Pydantic to delegate tasks based on domain expertise.</data>
      <data key="d1">UNKNOWN</data>
