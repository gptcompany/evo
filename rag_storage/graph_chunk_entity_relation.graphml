    <node id="RAG-Anything">
      <data key="d0">RAG-Anything</data>
      <data key="d1">Concept</data>
      <data key="d2">RAG-Anything is an advanced system for processing multimodal documents using deep learning algorithms.</data>
      <data key="d3">chunk-185372c097aa8f60f0a0cc241f3b2b08</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1757966408</data>
